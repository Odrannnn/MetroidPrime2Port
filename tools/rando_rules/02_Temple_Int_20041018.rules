# Great Temple (02_Temple_Int_20041018), light and dark areas.
#
# Sources: disc data via tools/rando_world.py --dump-obstacles, the decomp
# source in this repo, and knowledge of the game. No randomizer logic
# database was used.
#
# Same conventions as 01_Temple_Hub_20041018.rules: the post-steal starting
# inventory is assumed, dock locks (beam, translator, script) are applied by
# the evaluator, Dark Aether atmosphere is generated, light-to-dark portals
# need DarkBeam, dark-to-light portals need LightBeam.
# The Mothlord Sanctuary hub's translator doors (Emerald, Amber, Violet) are
# dock locks and are not repeated.

# ---------------------------------------------------------------- light world

area OF_Temple_hall_top
    # Single dock (the Transport C link); nothing to cross.
    dock0 - tel0x00000098: any

area 0g_temple_hall
    dock0 > dock1: any
    dock1 > dock0: SpaceJumpBoots  # terrain: a sheer 4.8-unit step spans the hall (y 64.5) below the dock0 side, above a standing jump
    # Missile alcove 15 units behind a barrier that needs a blast or a roll-through.
    dock0 > loc0x00010099: SuperMissile | MorphBallBombs | Powerbomb | BoostBall | ScrewAttack  # unsure: barrier is off the hall axis (x 24 vs 1.3); assumed to guard the alcove
    dock1 > loc0x00010099: SuperMissile | MorphBallBombs | Powerbomb | BoostBall | ScrewAttack  # unsure: same barrier
    covers 0x00010121

area 07_temple_mothlordsanctuary
    dock0 - dock1: any
    dock0 - dock2: any
    dock0 - dock3: any
    dock1 - dock2: any
    dock1 - dock3: any
    dock2 - dock3: any
    # The Energy Transfer Module sits at floor level in the centre of the room;
    # the cocoon platform (layer 2) is 18 units above it and is climbed to reach the
    # upper ring.
    dock0 > loc0x00020127: SpaceJumpBoots & (BoostBall | ScrewAttack)  # unsure: cocoon platform may not be needed for the floor-level item; item layer/trigger not checked
    dock1 > loc0x00020127: SpaceJumpBoots & (BoostBall | ScrewAttack)  # unsure: as above
    dock2 > loc0x00020127: SpaceJumpBoots & (BoostBall | ScrewAttack)  # unsure: as above
    dock3 > loc0x00020127: SpaceJumpBoots & (BoostBall | ScrewAttack)  # unsure: as above
    covers 0x08020104

area 0l_temple_hall
    dock0 - dock1: any

area om_temple_hall_top
    # Single dock (the Transport A link); nothing to cross.
    dock0 - tel0x0006002C: any

area 0h_temple_hall
    dock0 - dock1: any  # dock1 is 30 units above dock0; the Elevator platform (PLAT 0x00040077) lifts between them

area 0i_temple_hall
    dock0 - dock1: any
    dock0 > loc0x000500CF: any
    dock1 > loc0x000500CF: any  # unsure: loc 13 units above the dock level; assumed reachable without jumping

area 0j_temple_hall_top
    # Single dock (the Transport B link); nothing to cross.
    dock0 - tel0x00080021: any

area 08_temple_sungenerator
    # dock1 (z 48.7) is a vertical link to the dark Sun Generator; the portal
    # near the floor (layer 14, off by default) is the way there.
    dock0 > dock1: DarkBeam  # unsure: portal on layer 14 starts disabled; assumed enabled by the time it matters
    dock1 > dock0: any
    # The Light Suit (layer 8) is handed over once Sanctuary's energy is back, i.e. after
    # Quadraxis. Events are not modelled, so require the Sanctuary/Quadraxis kit (fail closed).
    # The Light Suit is handed over once the three temple bosses are dead and their energy is back.
    dock0 > loc0x200702C7: AmorbisDefeated & ChykkaDefeated & QuadraxisDefeated  # unsure: returning each temple's energy assumed possible once its boss falls
    dock1 > loc0x200702C7: AmorbisDefeated & ChykkaDefeated & QuadraxisDefeated
    covers 0x3807035A

area 08_temple_sungenerator_dark
    dock0 - dock1: SpaceJumpBoots  # unsure: dock0 is 35 units above dock1; climb assumed to need Space Jump
    dock1 > dock0: SpaceJumpBoots  # unsure: as above
    dock0 > dock1: LightBeam  # unsure: dock1 is the portal arrival, portal 10 units from dock1
    covers 0x00090042

# ----------------------------------------------------------------- dark world

area 0h_temple_hall_dark
    dock0 > dock1: any  # the 30-unit fall down the shaft drifts under the lower room's ceiling onto its floor
    dock1 > dock0: ScrewAttack & SpaceJumpBoots  # the shaft is 30 units high with no lift or ramp; the room's Screw Attack hints (POIN, CAMH, TRGR "Screw Attack") mark the climb

area 07_temple_mothlordsanctuary_dark
    # Single dock (script-locked); nothing to cross.
