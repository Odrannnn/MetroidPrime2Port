# Torvus Bog (04_Swamp_World_20041018), light and dark areas.
#
# Sources: disc data via tools/rando_world.py --dump-obstacles, the SCLY
# script objects (PLAT/DOOR/BALT/WATR names and positions) of each area, the
# decomp source in this repo, and knowledge of the game. No randomizer logic
# database was used.
#
# Conventions used here:
# - Dock locks (beam, shield, translator, script) are applied by the
#   evaluator and are not repeated.
# - Light-to-dark portals need DarkBeam; dark-to-light portals need LightBeam.
#   A portal pair is the NoDoor dock that links an area to its other-world
#   twin; the dock node stands for the portal's arrival point.
# - Dark Aether atmosphere is not written here: tools/rando_rules.py generates it
#   per dark area from its safe zones and distances (docs/RANDOMIZER.md), and an
#   area's `atmosphere <req>` line overrides it.
# - Bomb requirements spell out MorphBall even though it is a starting item.
# - Water: Gravity Boost sits at the bottom of the Hydrodynamo chain
#   (00_pickup_swamp_c), so the way down is written without it; climbing back
#   up through deep water requires it. Flooded corridors are left at `any`.
# - NoDoor docks with no Portal object on either side (00_pickup_swamp_a d1,
#   07_swamp_shaft d5) get no edges: nothing on the disc shows how to use them.

# ---------------------------------------------------------------- light world

area 00_Elev_Swamp_Temple_B
    # single dock: the elevator to Temple Grounds
    dock0 - tel0x00000081: any

area 0a_swamp_hall
    dock0 - dock1: any

area 01_swamp_entrance
    # Torvus Lagoon: walkway round the lake; all docks at z 35-41 except d2
    # (z 25.6, Dark door to 0b), reached down the shore.
    dock4 - dock0: any
    dock4 - dock1: any
    dock4 - dock2: any
    dock4 - dock3: any
    dock4 > loc0x0002004B: GravityBoost | SpaceJumpBoots  # unsure: missile ~9 units below the dock level at the water's edge

area 0d_swamp_hall
    dock0 - dock1: any

area 0c_swamp_hall
    dock0 - dock2: MorphBall & MorphBallBombs  # terrain: the ball route drops into a 5-unit-high pit and leaves by a tunnel mouth 3 units up (z 35.3 to 38.3 at (80.5, -85) and to 38.1 at (90.5, -85)); standing Samus hits the ceiling before she can morph into it, so only a bomb jump climbs out
    dock0 > dock1: DarkBeam
    dock2 > dock1: DarkBeam
    dock1 > dock0: any
    dock1 > dock2: any
    dock0 > loc0x000400E0: MorphBall & SpiderBall  # unsure: spider track 17 units from the missile, 9 above it
    covers 0x0004008F 0x00000000

area 0b_swamp_hall
    dock0 - dock1: any  # unsure: d1 sits in the shallow water (z 25.6, water top ~30.6)
    dock0 > loc0x00050032: GrappleBeam
    covers 0x000500D7

area 00_pickup_swamp_a
    # Save station. d1 is a NoDoor link 26 units above the floor with no
    # Portal object on either side: no edge.

area 03_swamp_forgottenbridge
    # South end: d1 (z 40.6), d2 (z 55.6), the missile and the portal.
    # North end: d0, d4 (z 65.6). The bridge (bridge_before L3 / bridge_after
    # L2) is turned by the dark-side bomb slot; the Boost spinner drives the
    # gate platform at (6,36).
    dock1 - dock2: any
    dock2 > loc0x00070163: any
    dock2 > dock3: DarkBeam  # unsure: portal assumed on the south side of the bridge
    dock3 > dock2: any
    dock2 - dock4: (MorphBall & BoostBall) | (MorphBall & MorphBallBombs & DarkBeam & LightBeam & (DarkSuit | LightSuit))  # unsure: bridge turned from the dark side or the spinner gate
    dock4 - dock0: any
    covers 0x00070177 0x00070216 0x00070217

area 0i_swamp_hall
    # Two bomb slots turn the rotating platforms between the docks.
    dock0 - dock1: MorphBall & MorphBallBombs  # unsure: bomb slots rotate the bridge platforms
    dock1 > loc0x000B00D6: MorphBall & MorphBallBombs & SpaceJumpBoots  # unsure: missile 30 units above the docks
    covers 0x000B009E 0x000B00C5

area 0e_swamp_hall
    dock0 - dock1: any
    dock0 > loc0x000C0051: GrappleBeam  # unsure: grapple point 22 units from the missile ledge
    covers 0x000C0124

area 0h_swamp_hall
    dock0 - dock1: any

area 02_swamp_greatbridge
    # Lower level: d1, d3, d4, d5 (z 35-41); d2 (z 45.6); upper d0 (z 50.6)
    # above d1. The Kinetic Orb Cannon (z 38) fires to a Catch Morphball at
    # z 58.7. Power Bomb walls flank the Power Bomb expansion.
    dock1 - dock3: any
    dock1 - dock4: any
    dock1 - dock5: any
    dock1 - dock2: any  # unsure: route between the lower level and the Light door
    dock1 > dock0: MorphBall & SpaceJumpBoots  # unsure: cannon to the upper level
    dock0 > dock1: any
    dock2 > loc0x00090113: Powerbomb
    dock3 > loc0x00090113: Powerbomb
    covers 0x000901A0 0x000901AF 0x000900B5 0x00090207 0x000901A8

area 0f_swamp_hall
    # Upper corridor d0-d2 (z 48-51), lower d1-d3 (z 35.6) over deep water.
    # The energy tank chamber opens only from above: the Tunnel Plug sits in the
    # upper corridor floor (z 43.7); the Lower Entrance Blocker 0x0011009C turns
    # off only from inside (Fade Wall trigger 0x00110083), so it lets you out.
    dock0 - dock2: any
    dock0 > dock1: any
    dock2 > dock3: any
    dock1 - dock3: MorphBall & MorphBallBombs | ScrewAttack  # terrain: the ball route drops into a 5-unit-high pit and leaves by a tunnel mouth 3 units up (z 29.2 to 32.1 at (-40.5, -124.5) and to 32.2 at (-61, -124.5)); standing Samus hits the ceiling before she can morph into it, so only a bomb jump climbs out; Power Bombs don't bomb-jump
    dock1 > dock0: SpaceJumpBoots  # unsure: 15-unit climb
    dock3 > dock2: SpaceJumpBoots  # unsure: 12-unit climb
    dock0 > loc0x00110076: MorphBall & (MorphBallBombs | Powerbomb) | ScrewAttack
    dock2 > loc0x00110076: MorphBall & (MorphBallBombs | Powerbomb) | ScrewAttack
    dock1 > loc0x00110076: SpaceJumpBoots & MorphBall & (MorphBallBombs | Powerbomb) | ScrewAttack
    dock3 > loc0x00110076: SpaceJumpBoots & MorphBall & (MorphBallBombs | Powerbomb) | ScrewAttack
    covers 0x0011007D 0x00110044

area 00_map_swamp
    # single dock

