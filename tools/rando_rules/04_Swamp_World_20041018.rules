    dock1 > dock0: any
    dock0 > loc0x001F0026: any  # unsure: energy tank 83 units away on the same floor level
    covers 0x001F006B

area 04_swamp_temple
    # Torvus Temple: d0, d1, d2, d4, d5 at z 34-48; d3 at z 98 (50 up).
    dock4 - dock0: any
    dock4 - dock1: any
    dock4 - dock2: any
    dock4 - dock5: any
    dock4 > loc0x001B02DC: any  # unsure: Super Missile after the temple ambush
    dock4 > dock3: SpaceJumpBoots  # unsure: upper door 50 units above the floor
    dock3 > dock4: any

