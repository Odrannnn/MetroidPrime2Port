    dock2 > dock0: SpaceJumpBoots  # unsure: 24-unit climb back to the top door
    dock2 > loc0x00180032: Powerbomb  # unsure: the Power Bomb tree legs stand between the floor and the missile
    covers 0x00180008 0x00180046

area 0g_swamp_hall
    dock0 - dock1: any  # unsure: route through the Fluid Morphball Tunnel
    dock0 > loc0x001E0083: MorphBall  # unsure: missile beside the morph ball water tunnel

