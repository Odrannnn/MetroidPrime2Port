area 07_swamp_shaft
    # Hydrodynamo Station, flooded from z ~-22 to ~-80. Top: d0 (-17.7) and
    # d4 (-2.7). Ledges: d1, d2, d3 (-32.7). Bottom: d6 (-68.8) under the
    # Main Lock, opened by scanning the three lock buttons (Activation Scan
    # triggers). A water cannon fires the ball from the bottom slot to the
    # Catch Morphball at the top. The missile is tied to the Seeker targets.
    dock0 - dock4: any
    dock0 > dock1: any
    dock0 > dock2: any
    dock0 > dock3: any
    dock1 - dock2: any  # unsure: underwater ledges
    dock2 - dock3: any  # unsure: underwater ledges
    dock1 > dock0: GravityBoost  # 15-unit climb out of the water: the Space Jump reaches 7.7 (rando_terrain)
    dock2 > dock0: GravityBoost  # as above
    dock3 > dock0: GravityBoost  # as above
    dock0 > dock6: any  # unsure: three scanned locks open the main lock
    dock6 > dock0: MorphBall  # unsure: water cannon from the floor slot to the top
    dock2 > loc0x002800C7: SeekerLauncher  # unsure: pickup gated by the Seeker target counter
    covers 0x00280259 0x00280091
    ignore 0x002801F8: puffer spawner vent near the top, blocks no route
    ignore 0x002801F9: puffer spawner vent near the top, blocks no route

area 00_swamp_generator
