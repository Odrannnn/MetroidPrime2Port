area 03_sand_temple_dark
    # Dark Agon Temple (Amorbis). The three Dark Agon Keys open the arena;
    # the doors stay locked until the boss falls. Its last phase is fought
    # in Morph Ball with bombs. The layer-6 "Reflect Shots" barriers belong
    # to the fight.
    dock0 > @arena: AgonKey1 & AgonKey2 & AgonKey3  # unsure: where the key gate sits (assumed every arena entrance)
    dock1 > @arena: AgonKey1 & AgonKey2 & AgonKey3  # unsure: as above
    dock3 > @arena: AgonKey1 & AgonKey2 & AgonKey3  # unsure: as above
    @arena > loc0x28240265: MorphBall & MorphBallBombs  # unsure: Amorbis assumed to need bombs for the Morph Ball phase
    event AmorbisDefeated: loc0x28240265  # the boss drop appears when Amorbis falls; the Light Suit wants all three temple bosses
    @arena > dock0: MorphBall & MorphBallBombs  # unsure: doors assumed locked until Amorbis falls
    @arena > dock1: MorphBall & MorphBallBombs  # unsure: as above
    @arena > dock3: MorphBall & MorphBallBombs  # unsure: as above
    covers 0x18240088 0x18240084 0x18240083 0x1824029F 0x18240087 0x182402A0
    ignore 0x18240022: safe zone crystal, not a barrier
    ignore 0x18240016: safe zone crystal, not a barrier
    ignore 0x1824001A: safe zone crystal, not a barrier
    ignore 0x18240027: safe zone crystal, not a barrier
    ignore 0x1824001E: safe zone crystal, not a barrier
