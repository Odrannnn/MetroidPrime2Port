    dock0 - dock5: any
    dock3 - dock4: any
    dock3 > dock0: any
    dock0 > dock3: SpaceJumpBoots  # unsure: 8-unit climb to the upper walkway
    # Breakable windows 15-25 units from dock2.
    dock3 - dock2: (MorphBall & MorphBallBombs) | (MorphBall & Powerbomb) | (MorphBall & BoostBall) | ScrewAttack  # unsure: windows assumed to close the way to dock2
    dock0 > dock6: DarkBeam
    dock6 > dock0: any
    dock0 > loc0x002A011E: any
    covers 0x002A0188 0x002A02A1 0x002A02A2 0x002A02B0

