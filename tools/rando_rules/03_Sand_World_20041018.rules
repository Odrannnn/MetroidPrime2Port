# Agon Wastes (03_Sand_World_20041018), light and dark areas.
#
# Sources: disc data via tools/rando_world.py --dump-obstacles (dock, pickup
# and obstacle positions, layers, script names), the decomp source in this
# repo, and knowledge of the game. No randomizer logic database was used.
#
# Starting inventory assumed (see 01_Temple_Hub_20041018.rules): PowerBeam,
# ChargeBeam, CombatVisor, ScanVisor, VariaSuit, MorphBall.
#
# Conventions used here:
# - Dock locks (beam, shield, translator, script) are applied by the
#   evaluator and are not repeated.
# - Light-to-dark portals need DarkBeam; dark-to-light portals need LightBeam.
# - Dark Aether atmosphere is not written here: tools/rando_rules.py generates it
#   per dark area from its safe zones and distances (docs/RANDOMIZER.md), and an
#   area's `atmosphere <req>` line overrides it.
# - Bomb requirements spell out MorphBall even though it is a starting item.
# - "Breakable" below is the disc's own requirement set for Rock Blockers and
#   weak grates: bombs, Power Bomb, Boost Ball or Screw Attack.
# - Climbs of more than ~10 units between dock heights (z from the dump) need
#   SpaceJumpBoots unless a ramp is known; each such rule is marked unsure.
# - The three layer-6 TEL1 objects in 00_sand_generator are the Sun Generator
#   endgame warps; they and the generator areas are left unconnected.

# ---------------------------------------------------------------- light world

area 00_Elev_Sand_Temple_A
    dock0 - tel0x0000007A: any

area 0a_sand_hall
    dock0 - dock1: any

area 01_sand_entrance
    # dock3 (from the elevator) and dock2 are on the floor (z -27..-29);
    # dock1/dock4 (z -11.8) and the portal (z -8.4) sit on the upper level.
    dock3 - dock2: any
    dock3 - dock1: any  # unsure: upper doors 15 units above the floor; ramp assumed (the vanilla first visit reaches them with no items)
    dock3 - dock4: any  # unsure: as above
    dock1 - dock4: any
    dock1 > dock5: DarkBeam
    dock5 > dock1: any
    # Rock Blocker 22 units from the map station door.
    dock3 - dock0: (MorphBall & MorphBallBombs) | (MorphBall & Powerbomb) | (MorphBall & BoostBall) | ScrewAttack
    dock3 > loc0x00020180: SpaceJumpBoots & ScrewAttack & MorphBall & BoostBall  # unsure: Energy Tank 19 units above the floor near dock3; route not verified
    covers 0x000201F8

area 00_mapstation_sand
    # Single dock, nothing to collect.

area 0e_sand_hall
    # Layer 2 is on by default, so the Rock Blocker stands in the hall.
    dock0 - dock1: (MorphBall & MorphBallBombs) | (MorphBall & Powerbomb) | (MorphBall & BoostBall) | ScrewAttack  # unsure: layer-2 blocker may be removed by a script before the first visit
    covers 0x08040017

area 0f_sand_hall
    dock0 - dock1: any

area 0o_sand_hall
    dock0 - dock1: any
    # Energy Tank at z 1.8, above the docks; cannon and its trigger at z -19.
    dock1 > loc0x0006001F: MorphBall & MorphBallBombs  # unsure: assumes the bomb trigger arms the cannon that launches to the tank
    covers 0x00060089 0x000600A4

area 04_sand_mining
    dock1 - dock2: any
    # Portal sits 13 units below the dock2 level.
    dock2 > dock3: DarkBeam  # unsure: portal floor 13 below the docks; return climb assumed walkable
    dock3 > dock2: any  # unsure: as above
    # Power Bomb blocker in front of the lower pickup door (z -26.8).
    dock2 > dock0: MorphBall & Powerbomb
    dock0 > dock2: MorphBall & Powerbomb & SpaceJumpBoots  # unsure: 20-unit climb from the lower door
    dock2 > loc0x00080117: MorphBall & MorphBallBombs & SpaceJumpBoots  # unsure: Darkburst behind a chain of bomb slots and cannons
    covers 0x000802F0 0x00080315 0x0008016C 0x0008009D 0x000800FF 0x00080177 0x000802B9 0x000802BB

area 00_pickup_sand_a
    dock0 > loc0x000F002A: any

area 0d_sand_hall
    dock1 > dock0: any
    dock0 > dock1: SpaceJumpBoots  # unsure: 16.5-unit climb from dock0 to dock1
    dock1 > loc0x001000E8: any

area 0q_sand_hall
    dock0 - dock1: any
    dock0 > dock2: SpaceJumpBoots  # unsure: elevator door 16 units above dock0
    dock1 > dock2: SpaceJumpBoots  # unsure: elevator door 10 units above dock1
    dock2 > dock0: any
    dock2 > dock1: any
    dock1 > dock3: DarkBeam & SpaceJumpBoots  # unsure: portal at z 3.8, 20 above dock1
    dock3 > dock1: any
    dock0 > loc0x0009005B: MorphBall & MorphBallBombs  # unsure: Missile next to a bomb slot
    covers 0x00090026 0x000900AB

area 05_portalpuzzle
    dock0 > dock1: any
    dock1 > dock0: SpaceJumpBoots  # unsure: dock0 15.6 above dock1
    dock1 > dock2: MorphBall & MorphBallBombs  # the bomb slot powers this portal (disc: the Portal object needs no beam; 0x001203AD "Bombslot"); vanilla enters Dark Agon here before the Dark Beam
    dock2 > dock1: any
    covers 0x00120136 0x00120119 0x001200FD 0x001203AD

area 02_sand_sandfalls
    # dock0/dock2 at z 7.2, dock1 at 14.7, dock4 at -0.3, dock3 at -7.8.
    dock0 - dock2: any
    # dock1's ledge (floor 12.2) is reached only by Space Jumps: 5.0 steps from the
    # 2.2 floor, nothing walkable within 9 units of it stands higher.
    dock0 > dock1: SpaceJumpBoots
    dock2 > dock1: SpaceJumpBoots
    dock1 > dock0: any
    dock1 > dock2: any
    dock3 - dock4: any
    dock0 > dock3: any
    dock0 > dock4: any
    # The low level reaches the North door over the collapsed pillar: DTRG "Destroy
    # Middle Chunk" 0x000A008E (missile/screw) starts the Pillar Control Timer, which
    # drops PLAT "Pillar" 0x000A00B5 and turns on "Collapsed Pillar" 0x000A001D.
    dock3 > dock0: SpaceJumpBoots | Missile | ScrewAttack  # unsure: pillar ramp inferred from the script names and positions
    dock4 > dock0: SpaceJumpBoots | Missile | ScrewAttack  # unsure: as above
    dock0 > loc0x000A0228: MorphBall & SpiderBall & MorphBallBombs  # unsure: Missile at z 32, 11 units from an 18-row spider track; catch-ball trigger and cannons beside it
    covers 0x00000000 0x000A034A 0x000A0230 0x000A02BF 0x000A024E
    ignore 0x000A008D: unsure: Power Bomb wall 35 units from dock0 and below dock level; assumed not on a dock path

area 00_elev_sand_swamp_e
    dock0 - tel0x0013007B: any

area 0c_sand_hall
    dock0 - dock1: any

area 0g_sand_hall
    dock0 > dock1: any
    dock1 > dock0: SpaceJumpBoots  # sheer 6.0 step (9.2 to 15.2)

area 00_save_sand_a
    dock0 > loc0x00170014: any

area 0n_sand_hall
    dock0 - dock1: any
    dock0 > loc0x0018019E: MorphBall & MorphBallBombs  # unsure: Missile behind a cannon and bullseye puzzle
    covers 0x00180066 0x00180085 0x0018008D 0x001800DB 0x00180112 0x001800C5 0x001800D9 0x001800DD 0x001800DF 0x00180113 0x001800F8 0x0018010C

area 03_sand_temple
    # Agon Temple. dock3 (south) is the arena entrance; the Bomb Guardian
    # drops the bombs, and the bomb gates (left by dock0/dock3, right by
    # dock1/dock2) and the North/South floor gates open with them.
    dock3 - @arena: any
    @arena > loc0x081A0074: any  # unsure: Bomb Guardian assumed beatable with the Power Beam
    @arena - dock0: MorphBall & MorphBallBombs  # unsure: which doors sit behind which gate not verified; all gated
    @arena - dock1: MorphBall & MorphBallBombs  # unsure: as above
    @arena - dock2: MorphBall & MorphBallBombs  # unsure: as above
    covers 0x001A0019 0x001A0018 0x001A000D 0x001A0016 0x001A0017 0x001A005E 0x0C1A004D 0x0C1A00C0 0x101A0217 0x101A0218

area 06_sand_alamofront
    dock0 - dock2: any
    dock1 > dock0: any
    dock1 > dock2: any
    dock0 > dock1: SpaceJumpBoots  # unsure: dock1 12 above dock0
    dock2 > dock1: SpaceJumpBoots  # unsure: dock1 10 above dock2
    dock2 > loc0x001D022C: SpaceJumpBoots  # unsure: Dark Ammo 16.5 above dock2
    ignore 0x00000000: unsure: spider track near dock1 is an alternative route; the rules use SpaceJumpBoots instead

area 00_sand_generator_connect
    dock1 - dock0: MorphBall & MorphBallBombs  # unsure: bomb slot assumed to open the generator door
    covers 0x00220032

area 0p_sand_hall
    dock1 > dock0: any
    dock0 > dock1: MorphBall & MorphBallBombs  # unsure: dock1 16 above dock0; cannon puzzle assumed to be the way up
    dock0 > loc0x00230074: MorphBall & MorphBallBombs  # unsure: Power Bomb pickup 96 units from dock0 inside the cannon/bullseye puzzle
    covers 0x00230121 0x0023002C 0x00230033 0x00230036 0x0023004B 0x00230125

area 0h_sand_hall
    # Lower: dock4 (9.7), dock0 (13.8), morph tunnel dock2 (6.1).
    # Upper: dock1, dock3 (21.7).
    dock4 - dock0: any
    dock1 - dock3: any
    dock1 > dock4: any
    dock3 > dock4: any
    dock4 > dock3: SpaceJumpBoots  # unsure: 12-unit climb to the upper doors
    dock0 > dock1: SpaceJumpBoots  # unsure: 8-unit climb, ramp not verified
    # Two weak grates between dock4 and the morph tunnel.
    # The tunnel mouth on the dock2 side is 4.0 above its 3.4 floor (5.4 standing):
    # bomb jump, Boost Ball, or Space Jump then morph.
    dock4 > dock2: (MorphBall & MorphBallBombs) | (MorphBall & Powerbomb) | (MorphBall & BoostBall)  # unsure: grates assumed to close the morph tunnel (Screw Attack dropped for a ball path)
    dock2 > dock4: (MorphBall & MorphBallBombs) | (MorphBall & Powerbomb & SpaceJumpBoots) | (MorphBall & BoostBall)
    covers 0x00250035 0x0025003E

area 00_sand_generator
    # Sun Generator: endgame, no edges.
    ignore 0x18270198: layer 6 is off by default (Sun Generator portal)

area 0b_sand_hall
    dock1 - dock2: any
    dock0 > dock1: any
    dock0 > dock2: any
    dock1 > dock0: SpaceJumpBoots  # unsure: elevator door 10 above dock1
    dock2 > dock0: SpaceJumpBoots  # unsure: elevator door 6 above dock2, ramp not verified
    dock2 > loc0x0028007D: SpaceJumpBoots  # unsure: Missile at z 35.2, above every door

area 07_sand_alamoportalobservation
    # Lower: dock0 (13.8), dock1 (11.3), morph dock5 (6.1), portal floor 5.8.
