# Sanctuary Fortress and the Ing Hive (05_Cliff_World_20041018a), light and
# dark areas.
#
# Sources: disc data via tools/rando_world.py --dump-obstacles (dock, location
# and obstacle positions), the SCLY script objects of each area (object names,
# layers and connections), the decomp source in this repo, and knowledge of
# the game. No randomizer logic database was used.
#
# Starting inventory assumed (not relisted): PowerBeam, ChargeBeam,
# CombatVisor, ScanVisor, VariaSuit, MorphBall.
#
# Conventions used here (same as 01_Temple_Hub_20041018.rules):
# - Dock locks (beam, shield, translator, script) are applied by the
#   evaluator; rules describe movement inside a room only.
# - Light-to-dark portals need DarkBeam; dark-to-light portals need LightBeam.
#   A NoDoor dock with a portal object next to it is entered through that
#   portal; a NoDoor dock without one is arrival-only.
# - Dark Aether atmosphere is not written here: tools/rando_rules.py generates it
#   per dark area from its safe zones and distances (docs/RANDOMIZER.md), and an
#   area's `atmosphere <req>` line overrides it.
# - Bomb requirements spell out MorphBall even though it is a starting item.
# - Objects on layers that start inactive are listed as ignored unless the
#   rule already requires what they would need.
# - Vertical gaps of more than ~15 units with no recorded lift need
#   SpaceJumpBoots or a spider track; when that is a guess the rule is
#   marked # unsure.

# ---------------------------------------------------------------- light world

area 00_elev_cliff_temple_c
    # Elevator room: one dock, nothing to traverse.
    dock0 - tel0x00000026: any

area 0a_cliff_hall
    # Spinner + attract ball by dock1 raise the Luminoth door barrier.
    dock0 - dock1: MorphBall & BoostBall    # unsure: spinner may be optional
    covers 0x000100D4 0x000100DB

area 01_cliff_entrance
    # Sanctuary Entrance: the bridge is smashed on the first visit; the far
    # side is reached along the 87-segment spider track and bomb slots.
    dock1 - dock0: MorphBall & SpiderBall & MorphBallBombs    # unsure: post-bridge-smash route
    dock1 > loc0x000200E2: MorphBall & SpiderBall & MorphBallBombs & SpaceJumpBoots    # unsure: 43 units above dock1
    covers 0x00000000
    ignore 0x00020085: Power Bomb glass beside the dock0 elevator; shortcut not relied on    # unsure
    ignore 0x18020099: layer 6 starts inactive (post-bridge cannons)
    ignore 0x180203E8: layer 6 starts inactive (post-bridge cannons)
    ignore 0x18020177: layer 6 starts inactive (post-bridge cannons)
    ignore 0x180200C1: layer 6 starts inactive (post-bridge cannons)
    ignore 0x180203BD: layer 6 starts inactive (post-bridge cannons)
    ignore 0x180203C9: layer 6 starts inactive (post-bridge cannons)
    ignore 0x18020104: layer 6 starts inactive (post-bridge cannons)
    ignore 0x18020184: layer 6 starts inactive (post-bridge cannons)
    ignore 0x180203EE: layer 6 starts inactive (post-bridge cannons)
    ignore 0x1802035A: layer 6 starts inactive (post-bridge cannons)
    ignore 0x18020352: layer 6 starts inactive (post-bridge cannons)

area 0b_cliff_hall
    dock0 - dock1: any

area 0c_cliff_hall
    dock0 - dock1: any

area 02_cliff_reactorcore
    # Dynamo Works: floor docks 0, 3, 4 at z -139.7; docks 1, 2 on a
    # balcony 30 units up reached by the spider track.
    dock3 - dock0: any
    dock3 - dock4: MorphBall    # cannon + ball trigger by the pickup room door
    dock3 > dock1: MorphBall & SpiderBall    # the track foot hangs 11 above the floor: the ball cannon (Grab Ball) lifts onto it
    dock1 > dock3: any
    dock1 - dock2: any
    dock1 > loc0x00050063: MorphBall & SpiderBall    # unsure: spider track ends near the tank
    covers 0x00050059 0x0005002C 0x00000000

area 00_save_cliff_a
    # One dock.

area 00_pickup_cliff_a
    dock0 > loc0x000900CA: MorphBall & SpiderBall & SpaceJumpBoots    # unsure: 42 units above the door on a platform

area 0d_cliff_hall
    # Four bomb slots drive the gyroscope barriers.
    dock0 - dock1: MorphBall & MorphBallBombs    # unsure: layer-3 bomb slots may be pre-solved
    covers 0x0C0700AF 0x0C0700BD 0x0C0700D9 0x0C0700D2

area 0m_cliff_hall
    dock0 - dock1: any
    dock0 > loc0x00080163: any
    dock0 > dock3: DarkBeam
    dock0 > dock2: DarkBeam & MorphBall & Powerbomb    # unsure: portal sits behind the PB glass
    dock2 > dock0: any
    dock3 > dock0: any
    dock4 > dock0: any
    dock5 > dock0: any
    covers 0x000800A5 0x000800EE 0x0008013A
    ignore 0x00000000: 6-segment track by the PB glass; not on a dock path    # unsure

area 03_cliff_chicane
    # Watch Station. The PB glass tube stands on the line between dock2 and
    # dock0; bomb block 1, a bomb slot and the spider track lead to dock1.
    dock2 - dock0: MorphBall & Powerbomb    # unsure: tube may be beside the path
    dock2 - dock1: MorphBall & MorphBallBombs    # side-scroller: its spider tracks switch on only once you own the Spider Ball (CRLY 0x000A031F/0x000A0323/0x000A0325 'Does Player Have Spiderball?'), so the room is built to be crossed before it; unsure: bomb blocks and the bomb-slot conveyor assumed to be the rest of the way
    dock1 > loc0x000A0045: (MorphBall & (MorphBallBombs | Powerbomb | BoostBall)) | ScrewAttack
    dock0 > dock3: DarkBeam
    dock3 > dock0: any
    covers 0x000A000B 0x000A006C 0x000A0224 0x00000000 0x000A0064 0x000A010F

area 04_cliff_contraption
    # Main Research. dock0 is 20 units above dock1/dock2.
    dock1 - dock2: any
    dock2 > dock0: MorphBall & SpiderBall    # unsure
    dock0 > dock2: any
    dock2 > dock3: DarkBeam    # unsure: portal-to-dock pairing guessed from y positions
    dock3 > dock2: any
    dock4 > dock2: any
    dock2 > loc0x000B019F: MorphBall & SpiderBall & MorphBallBombs & EchoVisor    # unsure: behind Head Piece / echo gate
    covers 0x000B00A9 0x100B02FD 0x180B01C3 0x00000000

