area 08_cliff_ringtowers
    # Docks 0-3 are on the floor (z -9 to -1); the Dark Ammo sits 55 units
    # up above the portal, reached by the bomb slot, spider track and cannons.
    dock0 - dock1: any
    dock1 - dock3: any
    dock0 - dock2: any
    dock0 - dock3: any    # unsure: rotating platform between halves
    dock3 > dock4: DarkBeam
    dock4 > dock3: any
    dock3 > loc0x0018017E: MorphBall & MorphBallBombs & SpiderBall    # unsure
    covers 0x001800B2 0x001801AF 0x0018002A 0x0018002B 0x001800CF 0x0018004D 0x00000000

