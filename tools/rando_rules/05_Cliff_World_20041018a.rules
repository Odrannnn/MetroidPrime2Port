area 05_cliff_engineroom
    # Four spinners turn off the laser cannons; the Screw Attack sits on a
    # bomb slot mid-room. Portals: by dock1 (east) and dock2 (west).
    dock0 > dock1: DarkBeam
    dock1 > dock0: any
    dock0 > dock2: DarkBeam & MorphBall & BoostBall    # unsure: lasers between halves
    dock2 > dock0: MorphBall & BoostBall    # unsure
    dock0 > loc0x002C0067: MorphBall & BoostBall & MorphBallBombs    # unsure
    covers 0x002C00B7 0x002C026E 0x002C01A8 0x002C01EE 0x002C01F7 0x002C0204 0x002C0205 0x002C0219 0x002C021C 0x002C0234 0x002C0238

area 07cliff_gyro
    # Main Gyro Chamber. Docks 0, 3, 4 at the south end (y ~225); docks 1, 2
    # at the north end (y ~320) past the gyro, the boost glass ring and two
    # bomb slots. The Power Bomb is on layer 2 below an echo gate.
    dock0 - dock3: any
    dock0 - dock4: any
    dock3 - dock4: any
    dock0 > dock2: MorphBall & BoostBall & MorphBallBombs    # unsure: spinner by dock0 stops the gyro; terrain: the ball route drops into a 5-unit-high pit and leaves by a tunnel mouth 3 units up (z -11.2 to -8.2 at (90.5, 250.5)); standing Samus hits the ceiling before she can morph into it, so only a bomb jump climbs out
    dock2 > dock0: MorphBall & BoostBall    # unsure
    dock2 - dock1: MorphBall & BoostBall & MorphBallBombs    # glass ring + bomb slots
    dock2 > loc0x08240088: MorphBall & BoostBall & MorphBallBombs & SpiderBall & EchoVisor    # unsure: layer-2 item
    covers 0x002402C2 0x0024036B 0x00240154 0x1024019C 0x102401AE 0x1C240358 0x00000000
    ignore 0x08240029: layer 2 starts inactive
    ignore 0x08240097: layer 2 starts inactive
    ignore 0x08240072: layer 2 starts inactive
    ignore 0x08240079: layer 2 starts inactive
    ignore 0x14240283: layer 5 starts inactive
    ignore 0x14240298: layer 5 starts inactive

