    dock1 > dock2: MorphBall & Missile & DarkBeam  # unsure: portal on a ledge reached by the catch-morphball cannon
    dock0 > dock2: MorphBall & Missile & DarkBeam  # unsure: as above
    dock2 > dock0: any
    covers 0x00340037 0x00340190 0x003401A7 0x00340071 0x00340158 0x003401AE

