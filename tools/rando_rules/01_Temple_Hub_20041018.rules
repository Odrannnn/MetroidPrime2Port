    dock0 - dock1: any
    dock0 - dock2: any
    dock0 - dock3: any
    dock1 - dock2: any
    dock1 - dock3: any
    dock2 - dock3: any
    dock0 > loc0x2C2B0324: MorphBall & SpaceJumpBoots  # unsure: layer-11 missile 9-14 units above the docks; access not verified
    ignore 0x282B010C: layer 10 is off by default
    ignore 0x282B0050: layer 10 is off by default
    ignore 0x282B022A: layer 10 is off by default

