# Temple Grounds (01_Temple_Hub_20041018), light and dark areas.
#
# Sources: disc data via tools/rando_world.py --dump-obstacles and the SCLY
# script objects of each area, the decomp source in this repo, and knowledge
# of the game. No randomizer logic database was used.
#
# Starting inventory (belief, for the orchestrator to decide):
#   At the Landing Site, before the Ing steal: PowerBeam, ChargeBeam,
#   CombatVisor, ScanVisor, VariaSuit, MorphBall, Missile (launcher),
#   MorphBallBombs, SpaceJumpBoots.  # unsure: launcher/bombs/space jump at landing
#   After the steal (the state a randomized start is usually built on):
#   PowerBeam, ChargeBeam, CombatVisor, ScanVisor, VariaSuit, MorphBall.
#   The rules below assume only the post-steal set.
#
# Conventions used here:
# - Dock locks (beam, shield, translator, script) are applied by the
#   evaluator and are not repeated.
# - Light-to-dark portals need DarkBeam; dark-to-light portals need LightBeam.
# - Dark Aether atmosphere is not written here: tools/rando_rules.py generates it
#   per dark area from its safe zones and distances (docs/RANDOMIZER.md), and an
#   area's `atmosphere <req>` line overrides it.
# - Bomb requirements spell out MorphBall even though it is a starting item.
# - The 15 layer-3 TEL1 objects in 01_temple_hive01 ("Map to ...") are debug
#   warps; they are left unused.

# ---------------------------------------------------------------- light world

area 01_Temple_LandingSite
    dock0 > dock1: any
    dock1 > dock0: SpaceJumpBoots  # terrain: the dock0 door ledge is 9.6 units above the ground and the only links to it start from points 14 units higher still

area 0q_temple_hall
    dock0 - dock1: any
    dock0 > dock2: MorphBall  # through the morph tunnel; its dock0-side mouth is 2.9 units up (jump and morph)
    dock1 > dock2: MorphBall  # as above
    dock2 > dock0: MorphBall & MorphBallBombs  # terrain: the tunnel mouth is 3.0 units above the dock2-side step under 5.1 units of headroom, so a standing jump hits the ceiling first; bomb jump in
    dock2 > dock1: MorphBall & MorphBallBombs  # as above
    dock3 > dock0: MorphBall
    dock0 > dock3: MorphBall & SpaceJumpBoots & MorphBallBombs  # terrain: Space Jump to the ledge at -28.3 (7.2 up), then the morph tunnel climbs two 3-unit steps (-29 to -26.1 to -23.1) that only a bomb jump clears
    dock4 > dock0: MorphBall
    dock0 > dock4: MorphBall & SpaceJumpBoots  # unsure: morph tunnel 6.6 units above the floor; ledge reach not verified

area 0a_temple_hall
    dock0 - dock1: any
    dock1 > dock2: any
    dock2 > dock1: never  # unsure: dock2 is a drop hole 16 units below the hall; assumed not climbable

area 0t_temple_hall
    dock3 > dock0: any
    dock0 > dock3: SpaceJumpBoots  # terrain: the trench from dock0 (floor -40.7) meets the dock3 floor at a sheer 5.0 step across the corridor
    dock1 - dock2: MorphBall
    dock1 > dock0: MorphBall
    dock0 > dock1: MorphBall & SpaceJumpBoots  # unsure: morph tunnel 12.5 units above the floor
    dock2 > dock0: MorphBall
    dock0 > dock2: MorphBall & SpaceJumpBoots  # unsure: morph tunnel 10 units above the floor

area 09_temple_thirdleg
    dock0 - dock1: any
    dock0 - dock3: any
    dock1 - dock3: any
    dock2 > dock0: MorphBall
    dock0 > dock2: MorphBall & BoostBall  # terrain: morph tunnel 13.6 units above dock0, out of Space Jump reach; the half-pipe beside it climbs 16.4 (z -37.3 to -20.9)

area 0u_temple_hall
    dock0 - dock2: any
    dock1 > dock2: any  # unsure: dock1 is 60 units lower; assumed a walkable climb since the vanilla intro returns this way
    dock2 > dock1: any  # unsure: same 60-unit descent; assumed walkable

area 01_temple_hive01
    # 15 layer-3 "Map to ..." TEL1 objects: debug warps, unused.
    dock0 > loc0x18060234: any
    # Vanilla hands out the Missile Launcher here right after the steal, with no bombs, boost,
    # power bombs or screw, and dock0 is one-way: the walk out through dock1 must be open.
    loc0x18060234 - dock1: any
    ignore 0x000601D0: Luminoth webbing 10 units above and off the loc-dock1 line; a side nook, not the way out
    # dock0 is a hole in the ceiling (z -59.7, floor ~-104): no way back up.

area 12_temple_finalgate
    dock0 > dock1: MorphBall  # dock0 is a morph tunnel 10 units above dock1
    dock1 > dock0: MorphBall & SpaceJumpBoots  # terrain: the tunnel mouth (-25.4) overhangs the stair foot (-35.3); the nearest stair floor is 7.3 below it
    dock0 > loc0x00070057: MorphBall & BoostBall
    dock1 > loc0x00070057: MorphBall & BoostBall
    # The four Boost spinners count into "Puzzle Complete", whose cinematic
    # raises the ring holding the Seeker Launcher pickup.
    covers 0x0007009B 0x000700A3 0x000700A9 0x000700B4 0x000700B8 0x000700BC 0x000700CF 0x000700D5

area 0n_temple_hall
    dock2 > dock1: any
    dock1 > dock2: SpaceJumpBoots  # terrain: dock1's floor is a pit (-45.6) walled 6.0 to 8.5 below the upper floor holding dock2 and the portal
    dock1 > dock0: DarkBeam & SpaceJumpBoots  # terrain: as dock1 > dock2
    dock0 > dock1: any
    dock0 > dock2: any
    covers 0x00080050

area 0m_temple_hall
    dock0 - tel0x0009001B: any

area 02_temple_exploration
    dock0 - dock1: any
    dock0 - dock2: any
    dock1 - dock2: any

area 01_temple_hive_04
    dock0 - dock1: any
    dock0 - dock2: any
    dock1 - dock2: any

area 0e_temple_hive_hall
    dock0 - dock1: any

area 10_temple_pathofeyes
    dock0 - dock1: any
    dock0 - dock2: any
    dock1 - dock2: any
    dock3 > dock0: any
    # dock3 is the arrival point of the dark-side portal; there is no light
    # portal object in this area, so nothing leads into dock3.

area 0k_temple_hall
    dock0 - dock1: any

area 0b_temple_hall
    dock0 - dock1: any

area 01_temple_hive03
    dock0 - dock1: any
    dock0 > loc0x1011013B: any
    dock1 > loc0x1011013B: any
    dock0 - dock2: any  # unsure: scripted first portal assumed pre-opened; leads only to the dark stub area
    dock1 - dock2: any  # unsure: as above
    covers 0x0011011B

area 00_save_hive04
    # Single dock, no location.

area 01_temple_hive02
    # The only thing between the docks is the gate in front of West2 (gate_open 0x0013008E, x 143).
    # The bomb slot that raises it is bombed before the Ing steal (the BombJump tutorial around it),
    # and the "Keep Gate OPEN" memory relay holds it up; the modelled start is post-steal.
    dock0 - dock1: any
    ignore 0x0013001A: weak grate into the bomb-slot alcove (y -414, south of both docks); done before the steal
    ignore 0x0013006B: the bomb slot (y -456) that opens the West2 gate; done before the steal

area 0r_temple_hall
    dock0 - dock1: MorphBall  # unsure: morph cannons assumed needed to cross
    dock0 > loc0x001600CB: MorphBall & GrappleBeam  # unsure: grapple point 26 units from the tank; cannon use not verified
    dock1 > loc0x001600CB: MorphBall & GrappleBeam  # unsure: as above
    covers 0x00160097 0x0016000A 0x00160036 0x00160021 0x001600AF 0x0016004A 0x001600B0

area 0o_temple_hall
    dock0 - dock1: any

area 00_elev_temple_sand_a
    dock0 - tel0x00180086: any
    dock0 > loc0x001800B4: MorphBall  # unsure: missile placement in the transport room not verified

area 03_temple_combattraining
    dock0 - dock1: any
    dock0 - dock2: any
    dock0 - dock3: any
    dock1 - dock2: any
    dock1 - dock3: any
    dock2 - dock3: any
    dock0 > dock4: DarkBeam
    dock4 > dock0: any
    dock0 > loc0x001900A4: SpaceJumpBoots  # unsure: missile sits 9 units above the dock level
    covers 0x0019029B

area 0f_temple_hive_hall
    dock0 - dock1: any

area 11_temple_grandpuzzle
    dock0 - dock1: any
    dock1 > dock2: DarkBeam
    dock2 > dock1: any
    # The grapple points (layers 2/3, off by default) are switched on by the
    # dark-side spinner puzzle; the Sunburst sits over a "Catch Morphball".
    dock0 > loc0x001D00F7: MorphBall & BoostBall & GrappleBeam & DarkBeam & LightBeam & (DarkSuit | LightSuit)  # unsure: puzzle chain inferred from layers and object names
    dock1 > loc0x001D00F7: MorphBall & BoostBall & GrappleBeam & DarkBeam & LightBeam & (DarkSuit | LightSuit)  # unsure: as above
    covers 0x001D0105 0x001D010B 0x001D006D 0x001D0124 0x081D0074 0x081D0075 0x0C1D0073 0x0C1D0076

area 00_elev_temple_swamp_b
    dock0 - tel0x001E000D: any

area 0c_temple_hall
    # The layer-2 gates are not shot down: scanning "Open Gate Scan" 0x081F00E3 runs the Gate Switch
    # Sequence 0x081F005D, which raises Gate 1 (North) and lowers Gates 2 and 3. Vanilla crosses
    # here from Temple Assembly Site right after the steal with nothing else.
    dock1 > dock0: ScanVisor
    dock0 > dock1: MorphBall & (MorphBallBombs | Powerbomb | BoostBall) | ScrewAttack  # unsure: from the North the closed Gate 1 sits before the scan point; the master layer switch at that door may change this
    dock0 > loc0x001F011A: MorphBall & Powerbomb
    dock1 > loc0x001F011A: MorphBall & Powerbomb
    covers 0x001F0018 0x081F00DF 0x081F003C 0x081F0048
    ignore 0x0C1F00DE: layer 3 is off by default
    ignore 0x0C1F0017: layer 3 is off by default
    ignore 0x0C1F0061: layer 3 is off by default

area 0j_temple_hall
    dock0 - tel0x00200063: any

area 00_pickup_temple_b
    dock0 > loc0x0021001C: any

area 0s_temple_hall
