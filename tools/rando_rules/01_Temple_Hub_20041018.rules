area 12_temple_finalgate_dark
    # Sky Temple gateway: all nine Temple Keys open it.
    dock0 - tel0x082A0084: TempleKey1 & TempleKey2 & TempleKey3 & TempleKey4 & TempleKey5 & TempleKey6 & TempleKey7 & TempleKey8 & TempleKey9  # unsure: which of the three teleporters is the live one
