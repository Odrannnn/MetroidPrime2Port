area 04_temple_unknownenemies
    dock1 - dock2: any
    dock0 > dock1: any
    dock0 > dock2: any
    dock1 > dock0: SpaceJumpBoots  # unsure: dock0 is 17 units above the floor
    dock2 > dock0: SpaceJumpBoots  # unsure: as above
    dock0 > loc0x00270139: MorphBall & (MorphBallBombs | Powerbomb)  # terrain: dock0's ledge (-23) drops onto the chamber's shelf
    dock1 > loc0x00270139: MorphBall & (MorphBallBombs | Powerbomb) & SpaceJumpBoots  # terrain: the Stasis Chamber stands on a shelf ring (-33.4) 5.2 above the pit floor (-38.6) dock1 and dock2 open onto
    dock2 > loc0x00270139: MorphBall & (MorphBallBombs | Powerbomb) & SpaceJumpBoots  # terrain: as dock1
    covers 0x00270125

